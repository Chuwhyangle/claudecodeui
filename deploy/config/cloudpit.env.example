# Environment for the `cloudpit` systemd user unit (and for a foreground run).
#
# Install at `~/.config/cloudpit/cloudpit.env`; the unit reads it with
# `EnvironmentFile=-%h/.config/cloudpit/cloudpit.env` (the leading `-` means a
# missing file is not an error).
#
# Everything here is site-specific on purpose: the shipped unit has no personal
# path or address baked into it.

# Bind address. A concrete interface address is safer than 0.0.0.0 on a machine
# with many docker bridges; 127.0.0.1 restricts it to the host.
HOST=127.0.0.1
SERVER_PORT=3001

# Absolute path to the `claude` CLI this server must spawn, when the user
# manager's PATH cannot be relied on to resolve it.
# CLAUDE_CLI_PATH=%h/.local/bin/claude

# Off-browser desktop alerts (see scripts/windows-notify/). Blank or unset
# disables the channel; the startup log then prints
#   Awaiting-reply desktop alerts are off (CLOUDPIT_DESKTOP_NOTIFY_CMD is unset)
# The pre-rename spelling CLOUDCLI_DESKTOP_NOTIFY_CMD is still honoured as a
# fallback, so an existing deployment can migrate the name at its own pace.
# CLOUDPIT_DESKTOP_NOTIFY_CMD=ssh -o BatchMode=yes -o ConnectTimeout=5 winbox powershell -NoProfile -ExecutionPolicy Bypass -File 'C:\Users\<you>\cloudpit-notify\enqueue.ps1'
